{
  "uid": "flowlab-engine",
  "title": "FlowLab \u00b7 Engine health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Completed executions",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "flowlab-prometheus"
      },
      "targets": [
        {
          "expr": "flowlab_executions_completed_total",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Task retries",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "flowlab-prometheus"
      },
      "targets": [
        {
          "expr": "flowlab_task_retries_total",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Task failures",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "flowlab-prometheus"
      },
      "targets": [
        {
          "expr": "flowlab_task_failures_total",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Recovered leases",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "flowlab-prometheus"
      },
      "targets": [
        {
          "expr": "flowlab_recovery_attempts_total",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Mean task duration (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "flowlab-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flowlab_task_duration_seconds_sum[5m])) / sum(rate(flowlab_task_duration_seconds_count[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Outbox publications",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "flowlab-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(flowlab_outbox_published_total[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
